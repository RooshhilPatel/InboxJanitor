# InboxJanitor runtime configuration template. Copy to .env. Never commit real secrets.

# Dedicated OAuth client (Desktop app) — separate from the MegaNewsletterDashboard client so the
# Gmail grant can be revoked independently without breaking newsletter Drive sync.
GMAIL_CLIENT_ID=replace-with-google-oauth-client-id
GMAIL_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Written by `npm run auth`.
GMAIL_REFRESH_TOKEN=

# How far back the cold scan reaches. Everything currently in the inbox is scanned regardless of age.
SCAN_WINDOW=3y

# Concurrent in-flight Gmail requests. Actual pacing is governed by SCAN_UNITS_PER_SEC below, so
# this mainly controls how many sockets are open at once.
SCAN_CONCURRENCY=20

# Quota units per second. Gmail enforces 250 units/sec AND 15,000 units/min per user; a metadata
# fetch costs 5. 200 units/sec = 40 fetches/sec = 12,000 units/min, leaving 20% headroom under both
# ceilings and room for the newsletter automation running alongside. Raising this risks a stall:
# once the per-minute bucket is spent, every request fails for up to a full minute.
SCAN_UNITS_PER_SEC=200
